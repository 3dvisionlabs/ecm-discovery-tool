{
  "name": "ecm-discovery",
  "productName": "Edge Camera Discovery",
  "version": "0.10.0-alpha.1",
  "description": "Discover 3dvisionlabs ECM cameras on the local network",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "3dvisionlabs GmbH",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "make": "tauri build",
    "test": "cargo test --workspace",
    "lint": "eslint .",
    "icons": "tauri icon app-icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/Square* src-tauri/icons/StoreLogo.png src-tauri/icons/64x64.png",
    "mock:ecmdp": "tsx scripts/ecmdp-mock.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true
  }
}
